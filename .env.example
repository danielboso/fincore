# Database Credentials (Do not use default or weak credentials in production!)
POSTGRES_USER=fincore_user
POSTGRES_PASSWORD=set_a_strong_password_here
POSTGRES_DB=fincore

# Ports (Docker Local Development)
APP_PORT=3000
DB_PORT=5432

# Database URL for Local Development
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${POSTGRES_DB}
